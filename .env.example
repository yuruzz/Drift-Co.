# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required for persistent orders and notification settings on Vercel.
# Create/link an Upstash Redis database in Vercel Storage to populate these.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Set a long, unique Studio PIN (at least 32 random characters) in the hosting
# provider's environment settings. Never commit the real value to this file.
STUDIO_ADMIN_PIN=""

# PayMongo dynamic QR Ph. Keep the secret and webhook keys server-side only.
# QR Ph stays disabled unless PAYMONGO_QRPH_ENABLED is explicitly set to "true".
# Configure the webhook to POST payment.paid, payment.failed, and qrph.expired
# events to https://your-domain/api/payments/paymongo/webhook.
PAYMONGO_QRPH_ENABLED="false"
PAYMONGO_SECRET_KEY=""
PAYMONGO_PUBLIC_KEY=""
PAYMONGO_WEBHOOK_SECRET=""

# Optional dedicated quote-signing secret (32+ characters). If omitted, the existing
# 32+ character STUDIO_ADMIN_PIN is used to sign delivery quotes.
DELIVERY_QUOTE_SECRET=""
